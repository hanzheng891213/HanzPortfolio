{
  "name": "hanz-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "dev:api": "wrangler dev --config worker/wrangler.toml --port 8787",
    "db:init": "wrangler d1 execute hanzdev --file=db/schema.sql --local --config worker/wrangler.toml",
    "db:seed": "wrangler d1 execute hanzdev --file=db/seed.sql --local --config worker/wrangler.toml",
    "db:init:remote": "wrangler d1 execute hanzdev --file=db/schema.sql --remote",
    "db:seed:remote": "wrangler d1 execute hanzdev --file=db/seed.sql --remote"
  },
  "dependencies": {
    "hono": "^4.4.0",
    "pinia": "^2.1.7",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250528.0",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-vue": "^5.0.4",
    "typescript": "~5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.6",
    "wrangler": "^4.95.0"
  }
}
